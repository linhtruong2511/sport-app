PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication & Cookies
JWT_ACCESS_SECRET=sporthub-dev-access-secret-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# SePay Integration
SEPAY_WEBHOOK_API_KEY=sporthub-dev-sepay-key
SEPAY_API_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=

# SQL Server Configuration
# Auth modes: "windows" (Integrated Security via msnodesqlv8) or "sql" (SQL Login via tedious)
DB_AUTH_TYPE=windows
DB_SERVER=LINHTRUONG\SQLEXPRESS
DB_DATABASE=SportApp
DB_TEST_DATABASE=SportHub_Test
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# Only required when DB_AUTH_TYPE=sql
DB_USER=
DB_PASSWORD=
DB_PORT=1433
