PORT=3000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
CORS_ORIGIN=http://localhost:5173

# Authentication & Cookies (REQUIRED strong secret >= 32 chars in production)
JWT_ACCESS_SECRET=sporthub-dev-access-secret-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# SePay Integration (REQUIRED non-default key in production)
SEPAY_WEBHOOK_API_KEY=sporthub-dev-sepay-key
SEPAY_API_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=

# SQL Server Configuration
# Auth modes: "sql" (SQL Login via tedious, Linux/Docker/Production) or "windows" (Integrated Security via optional msnodesqlv8 on Windows)
DB_AUTH_TYPE=sql
DB_SERVER=localhost
DB_DATABASE=SportHub
DB_TEST_DATABASE=SportHub_Test
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# Required when DB_AUTH_TYPE=sql
DB_USER=sa
DB_PASSWORD=
DB_PORT=1433
