{
  "name": "sportapp-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Node.js backend for SportApp connected to SQL Server",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:test": "tsx src/scripts/testDb.ts",
    "db:reset": "tsx src/scripts/dbReset.ts",
    "db:migrate": "tsx src/scripts/dbMigrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/websockets": "^12.6.0",
    "@sporthub/shared": "*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "node-cron": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@swc/core": "^1.11.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.22.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.27.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.9"
  }
}
