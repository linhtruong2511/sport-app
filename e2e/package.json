{
  "name": "sporthub-ui-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E test suite for SportHub (React SPA + NestJS Backend + SQL Server)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
